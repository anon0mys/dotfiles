# Ignore all runtime state
*

# Track config files
!.gitignore
!CLAUDE.md
!settings.json

# Track slash commands and agents
!commands/
!commands/**
!agents/
!agents/**

# Track hook scripts and shared libraries (portable across machines)
!hooks/
!hooks/**
!lib/
!lib/**
# But not Python bytecode caches
__pycache__/
*.pyc
